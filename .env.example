# Database URL for PostgreSQL or SQLite
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# JWT Auth Secret for Admin Sessions
JWT_SECRET="your_jwt_secret_key_here"

# Admin Initial Seed Credentials
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_INITIAL_PASSWORD="your_strong_admin_password_here"

# App Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional Third Party Service Integrations (Disabled if unconfigured)
EMAIL_PROVIDER_API_KEY=""
WHATSAPP_API_TOKEN=""
PAYMENT_GATEWAY_KEY=""

# Web Push VAPID Configuration (Admin Notifications)
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your_vapid_public_key_here"
VAPID_PRIVATE_KEY="your_vapid_private_key_here"
VAPID_SUBJECT="mailto:admin@tawakalbbq.com"

# Admin Business WhatsApp Number for Customer Click-to-Chat (wa.me)
NEXT_PUBLIC_WHATSAPP_ADMIN_NUMBER="923485650906"
