# Database URL for PostgreSQL or SQLite
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# JWT Auth Secret for Admin Sessions
JWT_SECRET="your_jwt_secret_key_here"

# Admin Initial Seed Credentials
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_INITIAL_PASSWORD="your_strong_admin_password_here"

# App Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional Third Party Service Integrations (Disabled if unconfigured)
EMAIL_PROVIDER_API_KEY=""
WHATSAPP_API_TOKEN=""
PAYMENT_GATEWAY_KEY=""
